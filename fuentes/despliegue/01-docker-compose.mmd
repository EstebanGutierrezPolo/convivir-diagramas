%% titulo: Despliegue con Docker Compose
%% Refleja el archivo docker-compose.yml del proyecto.
flowchart LR
    subgraph pc["«device» PC del usuario"]
        nav["«execution environment»<br/>Navegador web"]
    end

    subgraph host["«device» Equipo anfitrión · Docker Desktop"]
        direction TB
        subgraph red["Red interna de Docker Compose"]
